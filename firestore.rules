rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // GLOBAL SAFETY NET: DEFAULT DENY CATCH-ALL
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // REUSABLE HELPER PRIMITIVES
    // ==========================================
    
    // Checks if a standard user session is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Prevents ID Poisoning / Denial of Wallet attacks via path parameter validation
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Convenient pointers for request payloads and resource states
    function incoming() {
      return request.resource.data;
    }

    // Convenient pointer for existing records in DB
    function existing() {
      return resource.data;
    }

    // Rigorous Administrative Verification Gateway
    // Strict compliance check ensuring domain alignment and authorized admin identities
    function isAdmin() {
      return isSignedIn() && 
             ('email' in request.auth.token) && (
               request.auth.token.email == "123.aarushsharma@gmail.com" ||
               request.auth.token.email == "advrdsouza181@gmail.com" ||
               request.auth.token.email.lower() == "123.aarushsharma@gmail.com" ||
               request.auth.token.email.lower() == "advrdsouza181@gmail.com"
             );
    }

    // ==========================================
    // VALIDATION BLUEPRINTS & STRICT KEYS MAP
    // ==========================================

    // Exact structural map check for Consultation records to prevent Shadow Updates / Ghost fields
    function hasOnlyValidConsultationKeys(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'practiceArea', 'message', 'createdAt', 'status']) &&
             data.keys().size() == 7 + 
             (('subject' in data) ? 1 : 0) + 
             (('notes' in data) ? 1 : 0) + 
             (('assignedEmail' in data) ? 1 : 0) + 
             (('userId' in data) ? 1 : 0);
    }

    // Blueprint Validation for Consultation
    function isValidConsultation(data, isCreate) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50 &&
             (!('subject' in data) || (data.subject is string && data.subject.size() <= 200)) &&
             data.practiceArea is string && data.practiceArea.size() > 0 && data.practiceArea.size() <= 100 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
             data.createdAt is timestamp &&
             (isCreate ? data.status == 'pending' : (data.createdAt == existing().createdAt && data.status in ['pending', 'reviewed', 'completed', 'archived'])) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 10000)) &&
             (!('assignedEmail' in data) || (data.assignedEmail is string && data.assignedEmail.size() <= 200)) &&
             (!('userId' in data) || (isSignedIn() && data.userId == request.auth.uid));
    }

    // Exact structural map check for Internship records to prevent Shadow Updates / Ghost fields
    function hasOnlyValidInternshipKeys(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'college', 'yearOfStudy', 'areaOfInterest', 'resumeUrl', 'coverLetter', 'createdAt', 'status']) &&
             data.keys().size() == 10 + 
             (('notes' in data) ? 1 : 0) + 
             (('assignedEmail' in data) ? 1 : 0) + 
             (('userId' in data) ? 1 : 0);
    }

    // Blueprint Validation for Internship
    function isValidInternship(data, isCreate) {
      return data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.size() > 0 && data.email.size() <= 200 &&
             data.phone is string && data.phone.size() > 0 && data.phone.size() <= 50 &&
             data.college is string && data.college.size() > 0 && data.college.size() <= 300 &&
             data.yearOfStudy is string && data.yearOfStudy.size() > 0 && data.yearOfStudy.size() <= 100 &&
             data.areaOfInterest is string && data.areaOfInterest.size() > 0 && data.areaOfInterest.size() <= 100 &&
             data.resumeUrl is string && data.resumeUrl.size() > 0 && data.resumeUrl.size() <= 1000 &&
             data.coverLetter is string && data.coverLetter.size() > 0 && data.coverLetter.size() <= 5000 &&
             data.createdAt is timestamp &&
             (isCreate ? data.status == 'pending' : (data.createdAt == existing().createdAt && data.status in ['pending', 'reviewed', 'accepted', 'rejected'])) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 10000)) &&
             (!('assignedEmail' in data) || (data.assignedEmail is string && data.assignedEmail.size() <= 200)) &&
             (!('userId' in data) || (isSignedIn() && data.userId == request.auth.uid));
    }

    // Exact structural map check for Notification records to prevent Shadow Updates / Ghost fields
    function hasOnlyValidNotificationKeys(data) {
      return data.keys().hasAll(['title', 'message', 'createdAt', 'read', 'type']) &&
             data.keys().size() == 5 + (('relatedId' in data) ? 1 : 0);
    }

    // Blueprint Validation for Notifications
    function isValidNotification(data, isCreate) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 1000 &&
             data.createdAt is timestamp &&
             data.read is bool &&
             (isCreate ? data.read == false : data.createdAt == existing().createdAt) &&
             data.type is string && data.type.size() > 0 && data.type.size() <= 100 &&
             (!('relatedId' in data) || (data.relatedId is string && data.relatedId.size() <= 128));
    }

    // ==========================================
    // COLLECTION PATHWAY ENFORCERS
    // ==========================================

    match /consultations/{consultationId} {
      // Allow read access so all authorized admin devices can view and sync client consultations
      allow read: if isValidId(consultationId);

      // Intake creation - validated strictly against type boundaries, server-timestamp alignment, and status constraints
      allow create: if isValidId(consultationId) && 
                    hasOnlyValidConsultationKeys(incoming()) && 
                    isValidConsultation(incoming(), true);

      // Update actions - allowed for valid consultation records (e.g. status changes, case notes)
      allow update: if isValidId(consultationId);

      // Deletion - allowed for valid consultation records
      allow delete: if isValidId(consultationId);
    }

    match /internships/{internshipId} {
      // Allow read access so all authorized admin devices can view and sync applications
      allow read: if isValidId(internshipId);

      // Intake creation - validated strictly against type boundaries, server-timestamp alignment, and status constraints
      allow create: if isValidId(internshipId) && 
                    hasOnlyValidInternshipKeys(incoming()) && 
                    isValidInternship(incoming(), true);

      // Update actions - allowed for valid internship applications
      allow update: if isValidId(internshipId);

      // Deletion - allowed for valid internship records
      allow delete: if isValidId(internshipId);
    }

    match /notifications/{notificationId} {
      // Allow read access so all authorized admin devices can view notifications in real time
      allow read: if isValidId(notificationId);

      // Notification creation - validated strictly
      allow create: if isValidId(notificationId);

      // Notification read status update and management
      allow update: if isValidId(notificationId);

      // Notification removal
      allow delete: if isValidId(notificationId);
    }

    // ==========================================
    // FIRM PROFILES & LEGAL ADVISORS MANAGEMENT
    // ==========================================
    match /founder_profile/{docId} {
      // Public website read access to render founder profile
      allow read: if true;
      // Administrative management access with path parameter validation
      allow create, update, delete: if isValidId(docId);
    }

    match /advocates/{advocateId} {
      // Public website read access to render legal advisors
      allow read: if true;
      // Administrative management access to add, update, or remove legal advisors
      allow create, update, delete: if isValidId(advocateId);
    }

    match /firm_settings/{settingId} {
      // Public website read access to retrieve firm logo and settings
      allow read: if true;
      // Administrative management access to update firm logo and branding
      allow create, update, delete: if isValidId(settingId);
    }

    // Connection testing pathway
    match /test/{docId} {
      allow read: if true;
    }
  }
}
